<UserControl x:Class="Temple.UI.WPF.DD.Exploration.ExploreAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:scrollFree="clr-namespace:Craft.UIElements.Geometry2D.ScrollFree;assembly=Craft.UIElements"
             xmlns:exploration="clr-namespace:Temple.ViewModel.DD.Exploration;assembly=Temple.ViewModel"
             xmlns:reborn="clr-namespace:Craft.UIElements.Geometry2D.Reborn;assembly=Craft.UIElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Focusable="True"
             KeyDown="ExploreAreaView_OnKeyDown"
             KeyUp="ExploreAreaView_OnKeyUp" d:DataContext="{d:DesignInstance exploration:ExplorationViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="1" BorderBrush="Black">
            <reborn:GeometryView DataContext="{Binding}"
                                 FrameHandler="{Binding}"/>

        </Border>

        <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black">
            <Viewport3D Name="viewport">

                <Viewport3D.Camera>
                    <PerspectiveCamera
                        Position="{Binding CameraPosition}"
                        LookDirection="{Binding LookDirection}"
                        UpDirection="0,0,1"
                        FieldOfView="80"/>
                </Viewport3D.Camera>

                <!-- Dim ambient so the point light matters -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#202020"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!--Directional light, to show floor-->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <DirectionalLight Color="#666666"
                                          Direction="{Binding DirectionalLight}"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Player light -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <PointLight Color="white"
                                    Range="10"
                                    ConstantAttenuation="1"
                                    LinearAttenuation="0.2"
                                    QuadraticAttenuation="0.05"
                                    Position="{Binding PlayerLightPosition}" />
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Static content like walls, cylinders, NPCs, etc -->
                <ModelVisual3D Content="{Binding Scene3DStatic}"/>

                <!-- Dynamic content like doors, etc -->
                <ModelVisual3D Content="{Binding Scene3DDynamic}"/>

                <!-- Exploratory for fancying up doors-->
                <ModelVisual3D Content="{Binding Scene3DDynamicNew}"/>
            </Viewport3D>
        </Border>

        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="In-Game Menu"
                Width="120" Height ="30" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20"
                Command="{Binding GoToInGameMenu_Command}"/>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Width="300" Height="200" Background="BlanchedAlmond"
              Visibility="{Binding DisplayLocationInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding LocationInfo}"/>
            <Button Grid.Row="1" Content="Continue" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                    FontWeight="Bold" FontSize="16"
                    Command="{Binding CloseLocationInfo_Command}"/>
        </Grid>

    </Grid>
</UserControl>
