<UserControl x:Class="Temple.UI.WPF.DD.InGameMenu.InGameMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:inGameMenu="clr-namespace:Temple.ViewModel.DD.InGameMenu;assembly=Temple.ViewModel"
             xmlns:inventory="clr-namespace:Temple.UI.WPF.DD.InGameMenu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance inGameMenu:InGameMenuViewModel }">
    <Grid IsEnabled="{Binding Saves.IsInteractionEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="12">
            <StackPanel Orientation="Horizontal">
                <Label Content="Save slot" Target="{Binding ElementName=SaveSlot}"/>
                <ComboBox x:Name="SaveSlot" Width="60" ItemsSource="{Binding Saves.Slots}"
                          SelectedItem="{Binding Saves.SelectedSlot}" AutomationProperties.Name="Save slot"/>
                <Button Content="Save to slot" Margin="8,0,0,0" Padding="12,4"
                        Command="{Binding Saves.SaveCommand}" ToolTip="Replaces the save in the selected slot."/>
                <Button Content="Load slot" Margin="8,0,0,0" Padding="12,4"
                        Command="{Binding Saves.LoadCommand}"/>
                <Button Content="Back to game" Margin="20,0,0,0" Padding="12,4"
                        Command="{Binding Exit_Command}"/>
            </StackPanel>
            <TextBlock Text="{Binding Saves.StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="1">
            <TabItem Header="Inventory">
                <inventory:InventoryView DataContext="{Binding InventoryViewModel}"/>
            </TabItem>
            <TabItem Header="Quests">
                <inventory:QuestCollectionView DataContext="{Binding QuestCollectionViewModel}"/>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
